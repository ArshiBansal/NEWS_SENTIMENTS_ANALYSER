# News Pulse Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# Streamlit configuration
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0
# STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Reddit API (optional - for higher rate limits)
# REDDIT_CLIENT_ID=your_client_id
# REDDIT_CLIENT_SECRET=your_client_secret
# REDDIT_USER_AGENT=NewsPulse/1.0

# Translation API (optional - for production use)
# GOOGLE_TRANSLATE_API_KEY=your_api_key
# DEEPL_API_KEY=your_api_key

# Cache configuration
# REQUESTS_CACHE_EXPIRE=900  # 15 minutes in seconds
# REQUESTS_CACHE_BACKEND=sqlite

# Logging
# LOG_LEVEL=INFO
# LOG_FORMAT=json